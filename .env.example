# AeroEdits environment variables. Copy to .env (git-ignored) or set them in the cloud
# environment's settings. NOTHING here is needed to build or to run the test suite: every
# cloud-service test mocks its server, and the smoke test needs only FFmpeg and a wgpu adapter.
#
# The app reads keys from the OS keychain (Windows/macOS) or an owner-only file in the app's
# config folder (Linux); an environment variable overrides the stored key (src-tauri/src/secrets.rs).

# --- Cloud services (all optional; each costs money on the owner's account) ------------------
# OpenRouter: online transcription fallback (Scribe via OpenRouter), the app's filler/retake
# review, faceless narration (TTS, elevenlabs/eleven-v4-turbo), short-clip find. https://openrouter.ai
OPENROUTER_API_KEY=sk-or-placeholder
# ElevenLabs Scribe: first choice for online transcription. https://elevenlabs.io
ELEVENLABS_API_KEY=placeholder
# OpenAI: alternative cloud reviewer (rarely used). https://platform.openai.com
OPENAI_API_KEY=sk-placeholder
# Zernio: uploads to YouTube/TikTok/Instagram (PUB-2). https://zernio.com/dashboard
ZERNIO_API_KEY=placeholder
# Treg: X/Reddit/web search and page extraction for faceless research (FCL-1/2). https://treg.to
TREG_API_KEY=placeholder

# --- Tools and paths (optional) --------------------------------------------------------------
# FFmpeg/ffprobe to use instead of the bundled sidecar or PATH.
# AEROEDITS_FFMPEG=/usr/bin/ffmpeg
# AEROEDITS_FFPROBE=/usr/bin/ffprobe
# Make a missing FFmpeg / wgpu adapter fail tests instead of skipping them (CI sets the first).
# AEROEDITS_REQUIRE_FFMPEG=1
# AEROEDITS_REQUIRE_GPU=1
# Keep the smoke test's exported MP4 here (then: bash scripts/snapshot-frames.sh <file>).
# AEROEDITS_SMOKE_OUT=/tmp/smoke.mp4
# Graphics runtime (pinned Node + HyperFrames + chrome-headless-shell), downloaded on first use
# from nodejs.org, registry.npmjs.org and storage.googleapis.com. Point at a scratch folder.
# AEROEDITS_GRAPHICS_RUNTIME=/tmp/aeroedits-graphics-runtime
# Use these folders instead of the user's config folders (tests, trials).
# AEROEDITS_PRESETS_DIR=
# AEROEDITS_STYLES_DIR=
# AEROEDITS_TEMPLATES_DIR=
# AEROEDITS_GRAPHICS_LIBRARY=
# Debug builds only: suffix the MCP pipe/socket so a dev copy runs beside the installed app.
# AEROEDITS_MCP_DEV=dev
# Force an H.264 encoder (libx264, h264_nvenc, h264_amf, h264_qsv, h264_mf) / hardware decode.
# AEROEDITS_H264_ENCODER=libx264
# AEROEDITS_HWACCEL=
# Windows: AEROEDITS_PREVIEW=webview brings back the old JPEG preview path.
# AEROEDITS_PREVIEW=

# Probes (ignored tests run by hand on real recordings) take many AEROEDITS_*_PROBE / AERO_*
# variables; see the probe's own doc comment and docs/verification.md.
