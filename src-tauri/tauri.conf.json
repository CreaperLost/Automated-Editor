{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroEdits",
  "version": "0.1.0",
  "identifier": "com.aeroedits.editor",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../front-end"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../front-end"
    },
    "frontendDist": "../front-end/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AeroEdits",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
